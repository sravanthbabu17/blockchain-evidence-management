NODE_ENV=development
PORT=5000
HTTPS_PORT=5443
ENABLE_HTTP=true
ALLOWED_ORIGINS=http://localhost:3000
JSON_BODY_LIMIT=128kb
API_RATE_LIMIT=120
IMPACT_RATE_LIMIT=20

# Comma-separated per-device keys. Do not commit real values.
IOT_API_KEYS=replace-with-random-device-key

PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
SECONDARY_IPFS_ENABLED=false
SECONDARY_IPFS_API_URL=
SECONDARY_IPFS_API_KEY=

ALCHEMY_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=
NETWORK_NAME=sepolia
CHAIN_ID=11155111
NETWORK_MODE=testnet

# Production TLS. Required when NODE_ENV=production.
TLS_KEY_PATH=
TLS_CERT_PATH=
